#!/bin/sh
# Test double for the AWS CLI.
#
# Behaviour is driven by environment variables rather than arguments, so tests
# can exercise s3-manager--aws-async with any argv while still controlling the
# subprocess result:
#
#   FAKE_AWS_STDOUT   text written to stdout   (printf %b: \n \r honoured)
#   FAKE_AWS_STDERR   text written to stderr   (printf %b)
#   FAKE_AWS_EXIT     exit code                (default 0)
#   FAKE_AWS_DELAY    seconds to sleep before exiting (default 0)
#
# Arguments are echoed to FAKE_AWS_ARGV_FILE when set, so argv construction can
# be asserted against a real subprocess invocation.

# Appended, one record per invocation, records separated by a blank line.
# Overwriting would lose the command under test whenever it triggers a
# follow-up call -- a delete refreshing its listing, for instance.
if [ -n "$FAKE_AWS_ARGV_FILE" ]; then
    { for a in "$@"; do printf '%s\n' "$a"; done; printf '\n'; } \
        >> "$FAKE_AWS_ARGV_FILE"
fi

# Spawn a grandchild that inherits stderr and outlives us, so the stderr pipe
# stays open after this process exits.  That stalls a completion barrier which
# waits on both the process and its stderr stream.
if [ -n "$FAKE_AWS_HOLD_STDERR" ]; then
    sleep "$FAKE_AWS_HOLD_STDERR" &
fi

[ -n "$FAKE_AWS_DELAY" ] && sleep "$FAKE_AWS_DELAY"
[ -n "$FAKE_AWS_STDOUT" ] && printf '%b' "$FAKE_AWS_STDOUT"
[ -n "$FAKE_AWS_STDERR" ] && printf '%b' "$FAKE_AWS_STDERR" >&2

# Stay alive after writing, so a test can observe transient state -- progress
# in the mode line, say -- that completion would otherwise clear immediately.
[ -n "$FAKE_AWS_LINGER" ] && sleep "$FAKE_AWS_LINGER"

exit "${FAKE_AWS_EXIT:-0}"
